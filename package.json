{
  "name": "iobroker.shelfmate",
  "version": "0.1.3",
  "description": "Household inventory with barcode scanning, storage locations, minimum stock and shopping list",
  "author": {
    "name": "Henrik Schoenhofen",
    "email": "henrik.schoenhofen@icloud.com"
  },
  "contributors": [],
  "homepage": "https://github.com/backfisch88/ioBroker.shelfmate",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "inventory",
    "barcode",
    "pantry",
    "shopping list",
    "kitchen"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/backfisch88/ioBroker.shelfmate.git"
  },
  "engines": {
    "node": ">= 22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "@iobroker/webserver": "^3.3.1",
    "node-forge": "^1.4.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/dev-server": "^0.8.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.1",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.0.0"
  },
  "main": "main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "lib/",
    "!lib/**/*.test.js",
    "www/",
    "io-package.json",
    "LICENSE",
    "main.js"
  ],
  "scripts": {
    "test:js": "mocha --config test/mocharc.custom.json \"{!(node_modules|test)/**/*.test.js,*.test.js,test/**/test!(PackageFiles|Startup).js}\"",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:js && npm run test:package",
    "lint": "eslint -c eslint.config.mjs .",
    "translate": "translate-adapter",
    "dev-server": "dev-server",
    "release": "release-script"
  },
  "bugs": {
    "url": "https://github.com/backfisch88/ioBroker.shelfmate/issues"
  },
  "readmeFilename": "README.md"
}
