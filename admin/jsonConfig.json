{
    "i18n": true,
    "type": "panel",
    "items": {
        "_hServer": {
            "type": "header",
            "text": "hServer",
            "size": 3,
            "newLine": true,
            "xs": 12
        },
        "port": {
            "type": "number",
            "label": "port",
            "min": 1,
            "max": 65535,
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "bind": {
            "type": "ip",
            "listenOnAllPorts": true,
            "label": "bind",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "secure": {
            "type": "checkbox",
            "label": "secure",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "certPublic": {
            "type": "certificate",
            "certType": "public",
            "label": "certPublic",
            "hidden": "!data.secure",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "certPrivate": {
            "type": "certificate",
            "certType": "private",
            "label": "certPrivate",
            "hidden": "!data.secure",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "certChained": {
            "type": "certificate",
            "certType": "chained",
            "label": "certChained",
            "hidden": "!data.secure",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "createCert": {
            "type": "sendTo",
            "command": "createCertificate",
            "label": "createCert",
            "help": "createCertHelp",
            "variant": "outlined",
            "useNative": true,
            "showProcess": true,
            "hidden": "!data.secure",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "leCollection": {
            "type": "selectSendTo",
            "command": "getCertCollections",
            "manual": true,
            "label": "leCollection",
            "hidden": "!data.secure",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "accessKey": {
            "type": "password",
            "label": "accessKey",
            "help": "accessKeyHelp",
            "visible": true,
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "_hShop": {
            "type": "header",
            "text": "hShop",
            "size": 3,
            "newLine": true,
            "xs": 12
        },
        "shoppingMode": {
            "type": "select",
            "label": "shoppingMode",
            "options": [
                {
                    "value": "off",
                    "label": "modeOff"
                },
                {
                    "value": "script",
                    "label": "modeScript"
                },
                {
                    "value": "bring",
                    "label": "modeBring"
                },
                {
                    "value": "bringSpecial",
                    "label": "modeBringSpecial"
                }
            ],
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "shoppingAddItemId": {
            "type": "objectId",
            "label": "shoppingAddItemId",
            "help": "shoppingAddItemIdHelp",
            "hidden": "data.shoppingMode !== 'script'",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 8,
            "xl": 8
        },
        "shoppingContentId": {
            "type": "objectId",
            "label": "shoppingContentId",
            "help": "shoppingContentIdHelp",
            "hidden": "data.shoppingMode !== 'script'",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 8,
            "xl": 8
        },
        "shoppingRemoveItemId": {
            "type": "objectId",
            "label": "shoppingRemoveItemId",
            "help": "shoppingRemoveItemIdHelp",
            "hidden": "data.shoppingMode !== 'script'",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 8,
            "xl": 8
        },
        "bringListId": {
            "type": "selectSendTo",
            "command": "getBringLists",
            "manual": true,
            "label": "bringListId",
            "help": "bringListIdHelp",
            "hidden": "data.shoppingMode !== 'bring' && data.shoppingMode !== 'bringSpecial'",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 8,
            "xl": 8
        },
        "removeOnRestock": {
            "type": "checkbox",
            "label": "removeOnRestock",
            "help": "removeOnRestockHelp",
            "hidden": "data.shoppingMode === 'off' || (data.shoppingMode === 'script' && !data.shoppingRemoveItemId)",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 8,
            "xl": 8
        },
        "removeOnUncheck": {
            "type": "checkbox",
            "label": "removeOnUncheck",
            "help": "removeOnUncheckHelp",
            "hidden": "data.shoppingMode === 'off' || (data.shoppingMode === 'script' && !data.shoppingRemoveItemId)",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 8,
            "xl": 8
        },
        "_hBb": {
            "type": "header",
            "text": "hBestBefore",
            "size": 3,
            "newLine": true,
            "xs": 12
        },
        "bestBeforeMode": {
            "type": "select",
            "label": "bestBeforeMode",
            "help": "bestBeforeModeHelp",
            "options": [
                {
                    "value": "off",
                    "label": "bbOff"
                },
                {
                    "value": "product",
                    "label": "bbProduct"
                },
                {
                    "value": "batch",
                    "label": "bbBatch"
                }
            ],
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "bestBeforeWarnDays": {
            "type": "number",
            "label": "bestBeforeWarnDays",
            "help": "bestBeforeWarnDaysHelp",
            "min": 0,
            "max": 365,
            "hidden": "data.bestBeforeMode === 'off'",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "_hNotify": {
            "type": "header",
            "text": "hNotify",
            "size": 3,
            "newLine": true,
            "xs": 12
        },
        "notifyAdapter": {
            "type": "selectSendTo",
            "command": "getNotifAdapters",
            "manual": true,
            "label": "notifyAdapter",
            "help": "notifyAdapterHelp",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "notifyTarget": {
            "type": "text",
            "label": "notifyTarget",
            "help": "notifyTargetHelp",
            "hidden": "!data.notifyAdapter",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "notifyArea": {
            "type": "text",
            "label": "notifyArea",
            "help": "notifyAreaHelp",
            "hidden": "!String(data.notifyAdapter).startsWith('telegrammenu2')",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "notifyLow": {
            "type": "checkbox",
            "label": "notifyLow",
            "hidden": "!data.notifyAdapter",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "notifyExpiry": {
            "type": "checkbox",
            "label": "notifyExpiry",
            "hidden": "!data.notifyAdapter || data.bestBeforeMode === 'off'",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "notifyInventoryDays": {
            "type": "number",
            "label": "notifyInventoryDays",
            "min": 0,
            "max": 365,
            "hidden": "!data.notifyAdapter",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "notifyTime": {
            "type": "text",
            "label": "notifyTime",
            "hidden": "!data.notifyAdapter",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "notifyTest": {
            "type": "sendTo",
            "command": "testNotification",
            "jsonData": "{\"notifyAdapter\":\"${data.notifyAdapter}\",\"target\":\"${data.notifyTarget}\",\"area\":\"${data.notifyArea}\"}",
            "label": "notifyTest",
            "variant": "outlined",
            "showProcess": true,
            "hidden": "!data.notifyAdapter",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "_hLabels": {
            "type": "header",
            "text": "hLabels",
            "size": 3,
            "newLine": true,
            "xs": 12
        },
        "labelButtons": {
            "type": "select",
            "multiple": true,
            "label": "labelButtons",
            "help": "labelButtonsHelp",
            "options": [
                {
                    "label": "lbEan",
                    "value": "ean"
                },
                {
                    "label": "lbQr",
                    "value": "qr"
                },
                {
                    "label": "lbQrOnly",
                    "value": "qrOnly"
                },
                {
                    "label": "lbShelf",
                    "value": "shelf"
                },
                {
                    "label": "lbBox",
                    "value": "box"
                },
                {
                    "label": "lbOpened",
                    "value": "opened"
                },
                {
                    "label": "lbFreezer",
                    "value": "freezer"
                }
            ],
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 8,
            "xl": 8
        },
        "_hScanner": {
            "type": "header",
            "text": "hScanner",
            "size": 3,
            "newLine": true,
            "xs": 12
        },
        "scannerTimeout": {
            "type": "number",
            "label": "scannerTimeout",
            "help": "scannerTimeoutHelp",
            "min": 3,
            "max": 120,
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        }
    }
}
